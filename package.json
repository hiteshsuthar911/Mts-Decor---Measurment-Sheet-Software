{
  "name": "mts-decor-software",
  "productName": "MTS Decor",
  "description": "Civil & Interior Measurement Sheet & RA Billing Software",
  "author": "Hitesh Jagdish Suthar <hiteshsuthar911@gmail.com>",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "postinstall": "cd server && npm install",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV_URL=http://localhost:5173 electron .\"",
    "electron:build": "cross-env ELECTRON_BUILD=true npm run build && electron-builder",
    "electron:build:win": "cross-env ELECTRON_BUILD=true npm run build && electron-builder --win",
    "electron:build:mac": "cross-env ELECTRON_BUILD=true npm run build && electron-builder --mac",
    "electron:build:dir": "cross-env ELECTRON_BUILD=true npm run build && electron-builder --dir",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@vitejs/plugin-react": "^6.1.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "vite": "^8.2.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.mtsdecor.measurementsheet",
    "productName": "MTS Decor",
    "copyright": "Copyright © 2026 MTS Decor. Built by Hitesh Jagdish Suthar",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MTS Decor"
    }
  }
}
