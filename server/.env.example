# MS PRO - Environment Variables Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL
# In Render: Set these under "Environment Variables" in your Dashboard service settings

# MongoDB Atlas Connection String (with TLS/SSL)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.7hzqmcn.mongodb.net/ms-pro?retryWrites=true&w=majority

# Strong Random 256-bit Secret Key for JWT Signatures (Generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# Environment (development | production)
NODE_ENV=production

# Server Port (Render sets this automatically)
PORT=5001
